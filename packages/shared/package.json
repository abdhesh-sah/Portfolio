{
    "name": "@portfolio/shared",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "development": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./schema": {
            "types": "./src/schema.ts",
            "development": "./src/schema.ts",
            "default": "./dist/schema.js"
        },
        "./routes": {
            "types": "./src/routes.ts",
            "development": "./src/routes.ts",
            "default": "./dist/routes.js"
        },
        "./utils": {
            "types": "./src/utils.ts",
            "development": "./src/utils.ts",
            "default": "./dist/utils.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc -w",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "npm run type-check",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "drizzle-orm": "^0.45.1",
        "drizzle-zod": "^0.8.3",
        "satori": "0.63.2",
        "workbox-build": "7.4.1"
    },
    "peerDependencies": {
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "eslint": "^9.39.5",
        "rimraf": "^6.1.4",
        "typescript": "^5.7.3"
    }
}
